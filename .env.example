# Server
PORT=3000
HOST=0.0.0.0

# Set to 1 only when the site runs behind a trusted reverse proxy.
TRUST_PROXY=0

# Used to anonymise IP addresses stored with enquiries.
# Generate a long random value before going live.
IP_HASH_SALT=replace-with-a-long-random-string

# Optional: send each new enquiry to an automation service, CRM or email relay.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
